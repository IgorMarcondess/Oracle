CREATE OR REPLACE FUNCTION maior_nota (p1 in number, p2 in number)
return number
is maior number(3,1);
BEGIN
    IF(p1 > p2) THEN 
    maior := p1;
    RETURN maior;
    ELSE maior := p2;
    RETURN maior;
    END IF;
END;

SELECT maior_nota(18,16.2) from dual;


-- EXCEPTION PERSONALIZADA
DECLARE
	V_CONTA NUMBER(2);
	TURMA_CHEIA EXCEPTION; -- Variavel do exception
BEGIN
	SELECT COUNT(RA) INTO V_CONTA FROM ALUNO;
	IF V_CONTA = 5 THEN 
		RAISE TURMA_CHEIA; --ENVIADO A EXCEPTION
	ELSE 
		INSERT INTO ALUNO VALUES (&Ra,'&nome');
	END IF;
	EXCEPTION --INICIANDO O DETALHAMENTO DAS EXCEPTIONS
	WHEN TURMA_CHEIA THEN -- ENVIANDO A MENSAGEM DA EXCEPTION
		DBMS_OUTPUT.PUT_LINE('Não foi possível incluir: turma cheia');
END;
