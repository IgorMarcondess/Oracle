--MODO IN NÃO PERMITE ALTERAÇÃO NO PROCESSAMENTO
CREATE OR REPLACE FUNCTION teste_Soma (p1 in number, p2 in number)
return number
is soma number(4);
BEGIN
    soma := p1 + p2;
    RETURN soma;
END;

SELECT teste_soma(10,15) from dual;
SELECT teste_soma(&valor1, &valor2) from dual;

declare
    n1 number(4) := &valor1;
    n2 n1%type := &valor2;
    re n1%type;
begin
    re := teste_soma(n1, n2);
    DBMS_OUTPUT.PUT_LINE(re);
end;

