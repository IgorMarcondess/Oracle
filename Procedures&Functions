        WHEN NOME_EXCEÇÃO THEN COMANDOS;
        WHEN NOME_EXCEÇÃO THEN COMANDOS;
        ...
END;

drop table aluno cascade constraints;

create table aluno (rm number(1), nome varchar(20));

INSERT INTO aluno VALUES (1, 'Marcel');
INSERT INTO aluno VALUES (2, 'Maria');
INSERT INTO aluno VALUES (3, 'Teste');


DECLARE 
    V_RM ALUNO.RM %TYPE := 1; -- DECLARANDO UMA VARIAVEL E UTILIZANDO O (%TYPE) PARA FALAR QUE O TIPO DE DADO DA VARIAVEL É IGUAL AO RM DA TABELA
    V_NOME ALUNO.NOME%TYPE;
    
BEGIN
    SELECT NOME INTO V_NOME FROM ALUNO WHERE RM >= V_RM;
    DBMS_OUTPUT.PUT_LINE(V_RM || ' - ' || V_NOME);
    
EXCEPTION
    WHEN NO_DATA_FOUND THEN -- declarando exception para caso não exista a RM > V_RM
        DBMS_OUTPUT.PUT_LINE('Sem aluno com este RM');
    WHEN TOO_MANY_ROWS THEN -- Captura o erro caso a consulta retorne mais de uma linha 
        DBMS_OUTPUT.PUT_LINE('Há mais de um aluno com este RM');
END;

--Exceção personalizada está ligada com regra de negócio

CREATE OR REPLACE PROCEDURE PROC_NOME_ALUNO (P_RA IN CHAR) -- criando a procedure  onde recebe P_RA por parâmetro
IS
V_NOME VARCHAR2(50); -- declarando a variavel 
BEGIN
SELECT NOME INTO V_NOME
FROM ALUNO
WHERE RM = P_RA;
DBMS_OUTPUT.PUT_LINE(V_NOME);
END PROC_NOME_ALUNO; -- término da procedure 

EXEC PROC_NOME_ALUNO(2); --executando a procedure 

