CREATE TABLE Funcfiap (
    mat_fun NUMBER(3) PRIMARY KEY,
    nm_fun VARCHAR(30) NOT NULL,
    salario NUMBER(10,2));
    
INSERT INTO Funcfiap VALUES (1, 'Junior', 2000.00)

SELECT * FROM Funcfiap;
    
CREATE OR REPLACE ATUALIZA_VALOR
BEFORE UPDATE
OF salario
ON Funcfiap
BEGIN IF (salario < 0) then
UPDATE Funcfiap VALUES (:OLD.mat_fun, :OLD.salario, :NEW.salario)
END;




    
