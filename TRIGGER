CREATE OR REPLACE TRIGGER VERIFICA_VALOR --CRIAÇÃO DA TRIGGER
BEFORE UPDATE -- DEFININDO SE SERÁ BEFORE OU AFTER - E QUAL O TIPO DE ATUALIZAÇÃO (DELETE, UPDATE ETC)
OF valor --COLUNA QUE SERÁ UTILIZADA
ON Produto --TABELA QUE SERIA UTILIZADA
FOR EACH ROW 
BEGIN
INSERT INTO valor_produto VALUES (:OLD.codigo, :OLD.valor, :NEW.valor); 
END;


